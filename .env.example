# Shizu Security Bot - Environment Configuration

# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Default command prefix (Default: ?)
DEFAULT_PREFIX=?

# Bot Developers & System Owners (comma-separated Discord User IDs)
